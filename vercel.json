{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/services", "destination": "/services.html" },
    { "source": "/products", "destination": "/products.html" },
    { "source": "/product-details", "destination": "/product-details.html" },
    { "source": "/product-details/:match*", "destination": "/product-details.html" },
    { "source": "/events", "destination": "/events.html" },
    { "source": "/packages", "destination": "/packages.html" },
    { "source": "/locations", "destination": "/locations.html" },
    { "source": "/hyderabad", "destination": "/hyderabad.html" },
    { "source": "/bangalore", "destination": "/bangalore.html" },
    { "source": "/mumbai", "destination": "/mumbai.html" },
    { "source": "/gallery", "destination": "/gallery.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/:match*", "destination": "/admin.html" },
    { "source": "/((?!assets/|public/|.*\\..*).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
